@page "/batches/{BatchId}"
@using MockupWorkflow.Shared.Models
@using MockupWorkflow.Admin.Web.Services

@inject RecordsApiClient RecordsApiClient
@inject NavigationManager Navigation

<MudText Typo="Typo.h4">Production Batch</MudText>

<MudButton Variant="Variant.Text"
           Color="Color.Secondary"
           OnClick="@(() => Navigation.NavigateTo("/batches"))">
    ← Back to Batches
</MudButton>

<MudPaper Class="pa-4 mb-4">

    <MudGrid>

        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.caption">Batch ID</MudText>
            <MudText Typo="Typo.h6">@BatchId</MudText>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.caption">Product Type</MudText>
            <MudText Typo="Typo.h6">
                @(items.FirstOrDefault()?.ProductType ?? "-")
            </MudText>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.caption">Items</MudText>
            <MudText Typo="Typo.h6">@items.Count</MudText>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.caption">Processed</MudText>
            <MudText Typo="Typo.h6">
                @items.Count(x => x.MockupProcessed) / @items.Count
            </MudText>
        </MudItem>

    </MudGrid>

</MudPaper>

<MudDivider Class="my-4" />

@if (items.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        No items found for this batch.
    </MudAlert>
}
else
{
    <MudTable Items="items" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Phrase</MudTh>
            <MudTh>Product Type</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Mockup</MudTh>
            <MudTh>Folder</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.Phrase</MudTd>
            <MudTd>@context.ProductType</MudTd>
            <MudTd>@context.ProcessingStatus</MudTd>
            <MudTd>@(context.MockupProcessed ? "Yes" : "No")</MudTd>
            <MudTd>@context.FolderName</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter]
    public string BatchId { get; set; } = "";

    private List<PodItem> items = new();

    protected override async Task OnInitializedAsync()
    {
        items = await RecordsApiClient.GetBatchItemsAsync(BatchId);
    }
}