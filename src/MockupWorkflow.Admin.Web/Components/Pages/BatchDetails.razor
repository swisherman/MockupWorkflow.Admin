@page "/batches/{BatchId}"
@using MockupWorkflow.Shared.Models
@using MockupWorkflow.Admin.Web.Services

@inject RecordsApiClient RecordsApiClient
@inject NavigationManager Navigation

<MudText Typo="Typo.h4">Batch Overview</MudText>

<MudButton Variant="Variant.Text"
           Color="Color.Secondary"
           OnClick="@(() => Navigation.NavigateTo("/batches"))">
    ← Back to Batches
</MudButton>


@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @* Summary card *@
<MudPaper Class="pa-4 mb-4">

    <MudGrid>

        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.caption">Batch ID</MudText>
            <MudText Typo="Typo.h6">@BatchId</MudText>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.caption">Product Type</MudText>
            <MudText Typo="Typo.h6">
                @(items.FirstOrDefault()?.ProductType ?? "-")
            </MudText>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.caption">Items</MudText>
            <MudText Typo="Typo.h6">@items.Count</MudText>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.caption">Processed</MudText>
            <MudText Typo="Typo.h6">
                @items.Count(x => x.MockupProcessed) / @items.Count
            </MudText>
        </MudItem>

    </MudGrid>

</MudPaper>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="@isProcessing"
               OnClick="GenerateMockups">
        @(isProcessing ? "Processing..." : "Request Mockup Processing")
    </MudButton>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <MudAlert Severity="Severity.Info" Class="mt-3">
            @message
        </MudAlert>
    }
    <MudTable Items="items" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Phrase</MudTh>
            <MudTh>Product Type</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Mockup</MudTh>
            <MudTh>Folder</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Phrase</MudTd>
            <MudTd>@context.ProductType</MudTd>
            <MudTd>@context.ProcessingStatus</MudTd>
            <MudTd>
                <MudIcon Icon="@(context.MockupProcessed
                                                                             ? Icons.Material.Filled.CheckCircle
                                                                     : Icons.Material.Filled.RadioButtonUnchecked)"
                         Color="@(context.MockupProcessed
                                                                             ? Color.Success
                                                                             : Color.Default)" />
            </MudTd>
            <MudTd>@context.FolderName</MudTd>
        </RowTemplate>
    </MudTable>
}

<MudDivider Class="my-4" />


 


@code {
    [Parameter]
    public string BatchId { get; set; } = "";

    private List<PodItem> items = new();
    private bool isLoading = true;

    private bool isProcessing;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        items = await RecordsApiClient.GetBatchItemsAsync(BatchId);
         isLoading = false;

    }
    private async Task GenerateMockups()
    {
        try
        {
            isProcessing = true;
            message = null;

            var productType = items.FirstOrDefault()?.ProductType;

            await RecordsApiClient.ProcessBatchMockupsAsync(BatchId, productType);

            items = await RecordsApiClient.GetBatchItemsAsync(BatchId);

            message = "Mockup processing requested.";
            
        }
        catch (Exception ex)
        {
            message = $"Mockup processing failed: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}