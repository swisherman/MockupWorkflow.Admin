@page "/import"
@using System.IO
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using MockupWorkflow.Shared.Models;
@using MockupWorkflow.Shared.Manifests;

@using MockupWorkflow.Admin.Web.Models
@using MockupWorkflow.Admin.Web.Services
@inject RecordsApiClient RecordsApiClient
@inject FolderCreatorApiClient FolderCreatorApi
@inject PngUploadService PngUploadService
@rendermode InteractiveServer




<h3>Import POD Items</h3>

<p>Incoming value: @incomingBatchFolder</p>


<InputFile OnChange="HandleManifestFileSelected"
           accept=".json" />


<div class="mb-3">
    <label class="form-label">
        Mosswick source images
    </label>

    <InputFile OnChange="OnMosswickSourceImagesSelected"
               multiple
               accept=".png,.jpg,.jpeg,.webp" />

    @if (mosswickSourceImages.Count > 0)
    {
        <p class="mt-2">
            @mosswickSourceImages.Count image file(s) selected
        </p>
    }
</div>
<MudButton ButtonType="ButtonType.Button"
           Variant="Variant.Filled"
           Color="Color.Secondary"
           OnClick="ImportMosswickManifestAsync"
           Disabled="@(IsImporting ||
 manifestRecords.Count == 0 
|| mosswickSourceImages.Count == 0 )">
    @(IsImporting
        ? "Importing..."
        : "Import Mosswick Manifest")
</MudButton>

<input @bind="incomingBatchFolder"
       @oninput="OnIncomingBatchFolderChanged"
       placeholder="134247973614855797" />

<p>Paste a JSON array of PODItems below.</p>

<MudTextField T="string"
              Label="POD Items JSON"
              @bind-Value="JsonText"
              Immediate="true"
              Lines="20"
              Variant="Variant.Outlined"
              FullWidth="true"
               />

<MudSelect T="string"
           Label="Product Type"
           @bind-Value="productType">

    <MudSelectItem Value="@("tshirt")">T-Shirt</MudSelectItem>
    <MudSelectItem Value="@("mug")">Mug</MudSelectItem>
    <MudSelectItem Value="@("hoodie")">Hoodie</MudSelectItem>
    <MudSelectItem Value="@("sweatshirt")">Sweatshirt</MudSelectItem>


</MudSelect>
<br />
<br />

<MudButton ButtonType="ButtonType.Button" 
    Variant="Variant.Filled"
           Color="Color.Primary"
           OnClick="@(async () => await ImportPodItemsAsync())"
           Disabled="@IsImporting">
    @(IsImporting ? "Importing..." : "Import")
</MudButton>


@if (!string.IsNullOrWhiteSpace(batchId))
{
    <br />
    <MudTextField T="string"
                  Label="Batch ID"
                  Value="@batchId"
                  ReadOnly="true"
                  Variant="Variant.Outlined"
                  FullWidth="true" />
}

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
        <pre>@Message</pre>
    </MudAlert>
}

@code {
    private MosswickBatch? selectedMosswickBatch;

    private string batchId = string.Empty;
    private string productType = "tshirt";
    private string JsonText = "[]";

    private string Message = string.Empty;
    private bool IsImporting;
    private string incomingBatchFolder = "";
    private IBrowserFile? selectedManifestFile;
    private string manifestFileName = string.Empty;
    private List<MockupManifestRecord> manifestRecords = [];
    private Dictionary<string, object> BatchFolderInputAttributes = new()
{
    { "webkitdirectory", "webkitdirectory" },
    { "directory", "directory" }
};
    private IReadOnlyList<IBrowserFile> mosswickSourceImages =
        Array.Empty<IBrowserFile>();

    private void OnMosswickSourceImagesSelected(
    InputFileChangeEventArgs args)
    {
        mosswickSourceImages = args
            .GetMultipleFiles(100)
            .ToList();
    }





    private async Task HandleManifestFileSelected(
    InputFileChangeEventArgs e)
    {
        selectedManifestFile = e.File;
        manifestFileName = e.File.Name;

        try
        {
            await using var stream =
                selectedManifestFile.OpenReadStream(
                    maxAllowedSize: 5 * 1024 * 1024);

            manifestRecords =
                await JsonSerializer.DeserializeAsync<
                    List<MockupManifestRecord>>(
                        stream,
                        new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        })
                ?? [];

            selectedMosswickBatch =
                new MosswickBatch
                {
                    BatchFolder = string.Empty,
                    ManifestPath = manifestFileName,
                    Records = manifestRecords
                };

            Message =
                $"Loaded {manifestRecords.Count} manifest record(s) " +
                $"from {manifestFileName}.";
        }
        catch (JsonException ex)
        {
            manifestRecords = [];
            selectedMosswickBatch = null;

            Message =
                $"Invalid manifest JSON: {ex.Message}";
        }
        catch (Exception ex)
        {
            manifestRecords = [];
            selectedMosswickBatch = null;

            Message =
                $"Could not read manifest: {ex.Message}";
        }
    }


    private async Task ImportPodItemsAsync()
    {
        try
        {
          
            IsImporting = true;
            Message = string.Empty;
            batchId = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString();

            var items = JsonSerializer.Deserialize<List<PodItem>>(
                JsonText,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
           
            if (items != null)
            {
                PreparePodItems(
       items,
       batchId,
       productType);
            }


            if (items == null || items.Count == 0)
            {
                Message = "No PODItems found in JSON.";
                return;
            }

            var result = await CreateBatchAsync(items);

            if (result == null)
            {
                Message = "Import completed, but no result was returned.";
                return;
            }



            foreach (var item in items.Take(10))
            {
                Console.WriteLine(
                    $"Item: Phrase='{item.Phrase}', FolderName='{item.FolderName}', Filename='{item.Filename}'"
                );
            }
            await UploadImagesAsync(    batchId,    productType);

           

            Message =
         $"""
    Import completed successfully.

    Batch ID: {batchId}

    Product Type: {productType}

    Received: {result.Received}
    Inserted: {result.Inserted}
    Already Present: {result.AlreadyPresent}
    Folders Created: {items.Count * 2}
    """;
        }
        catch (JsonException ex)
        {
            Message = $"Invalid JSON: {ex.Message}";
        }
        catch (Exception ex)
        {
            Message = $"Import failed: {ex.Message}";
        }
        finally
        {
            IsImporting = false;
        }
    }

    
    private async Task ImportMosswickManifestAsync()
    {
        try
        {
            IsImporting = true;
            Message = string.Empty;

            if (selectedMosswickBatch == null ||
                selectedMosswickBatch.Records.Count == 0)
            {
                Message =
                    "Select a valid mockup manifest first.";
                return;
            }

            if (mosswickSourceImages.Count == 0)
            {
                Message =
                    "Select the Mosswick source image files.";
                return;
            }

            batchId = DateTimeOffset.UtcNow
                .ToUnixTimeMilliseconds()
                .ToString();

            var items = CreatePodItemsFromManifest(
                selectedMosswickBatch.Records,
                batchId);

            if (items.Count == 0)
            {
                Message =
                    "The manifest did not produce any mockup items.";
                return;
            }

            var productTypes = items
                .Select(item => item.ProductType)
                .Where(value =>
                    !string.IsNullOrWhiteSpace(value))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (productTypes.Count != 1)
            {
                throw new InvalidOperationException(
                    "A Mosswick batch must currently contain " +
                    "exactly one product type.");
            }

            var mosswickProductType = productTypes[0];

            incomingBatchFolder =
                await PrepareIncomingBatchFromManifestAsync(
                    selectedMosswickBatch.Records,
                    batchId);

            var result = await CreateBatchAsync(items);

            if (result == null)
            {
                Message =
                    "Import completed, but no result was returned.";
                return;
            }

            await UploadImagesAsync(
                batchId,
                mosswickProductType);

            Message =
                $"""
            Mosswick manifest imported successfully.

            Manifest: {manifestFileName}
            Batch ID: {batchId}
            Product Type: {mosswickProductType}
            Incoming Folder: {incomingBatchFolder}

            Received: {result.Received}
            Inserted: {result.Inserted}
            Already Present: {result.AlreadyPresent}
            Folders Created: {items.Count * 2}
            Images Prepared: {items.Count}
            """;
        }
        catch (Exception ex)
        {
            Message =
                $"Mosswick manifest import failed: {ex.Message}";
        }
        finally
        {
            IsImporting = false;
        }
    }
 

    private void OnIncomingBatchFolderChanged(ChangeEventArgs e)
    {
        incomingBatchFolder = e.Value?.ToString() ?? "";
        Console.WriteLine($"Changed incomingBatchFolder to '{incomingBatchFolder}'");
    }
    private void PreparePodItems(
    IEnumerable<PodItem> items,
    string currentBatchId,
    string currentProductType)
    {
        foreach (var item in items)
        {
            NormalizePodItemPath(item);

            item.BatchId = currentBatchId;
            item.ProductType = currentProductType;

            if (string.IsNullOrWhiteSpace(item.FolderName) &&
                !string.IsNullOrWhiteSpace(item.Phrase))
            {
                item.FolderName = item.Phrase.Replace(" ", ".");
            }

            item.MockupRoot = "/data/builds";
            item.ExpectedFolderName = item.FolderName;
            item.SourceKey =
                $"{item.BatchId}:{item.ProductType}:{item.FolderName}";
        }
    }
    private static void NormalizePodItemPath(PodItem item)
    {
        if (string.IsNullOrWhiteSpace(item.Filename))
        {
            return;
        }

        var normalizedPath =
            item.Filename.Replace('\\', '/');

        item.Filename =
            normalizedPath.Split('/').Last();

        if (string.IsNullOrWhiteSpace(item.FolderName))
        {
            var parts = normalizedPath.Split(
                '/',
                StringSplitOptions.RemoveEmptyEntries);

            var inputFoldersIndex = Array.FindIndex(
                parts,
                part => string.Equals(
                    part,
                    "input_folders",
                    StringComparison.OrdinalIgnoreCase));

            if (inputFoldersIndex >= 0 &&
                inputFoldersIndex + 1 < parts.Length)
            {
                item.FolderName =
                    parts[inputFoldersIndex + 1];
            }
        }

        if (string.IsNullOrWhiteSpace(item.Phrase) &&
            !string.IsNullOrWhiteSpace(item.FolderName))
        {
            item.Phrase =
                item.FolderName.Replace(".", " ");
        }
    }
    private async Task<ImportResult?> CreateBatchAsync(
    IReadOnlyList<PodItem> items)
    {
        var result =
            await RecordsApiClient.ImportAsync(items);

        if (result == null)
        {
            return null;
        }

        await FolderCreatorApi.CreateFoldersAsync(
           items.ToList());

        return result;
    }
    private async Task UploadImagesAsync(
    string batchId,
    string productType)
    {
        incomingBatchFolder = incomingBatchFolder?.Trim() ?? "";

        Console.WriteLine($"incomingBatchFolder = '{incomingBatchFolder}'");

        if (string.IsNullOrWhiteSpace(incomingBatchFolder))
        {
            throw new InvalidOperationException(
                "Incoming Batch Folder is required.");
        }

        var inputFoldersRoot =
            $"/incoming/{incomingBatchFolder}/input_folders";

        Console.WriteLine($"Scanning input folders root: {inputFoldersRoot}");

        await PngUploadService.UploadInputFoldersAsync(
            inputFoldersRoot,
            batchId,
            productType);
    }
    
    
    
    private static List<PodItem> CreatePodItemsFromManifest(
        IEnumerable<MockupManifestRecord> records,
        string currentBatchId)
    {
        var mapper = new MockupManifestItemMapper();

        return records
            .Select(record =>
                mapper.Map(record, currentBatchId))
            .ToList();
    }
    private async Task<string> PrepareIncomingBatchFromManifestAsync(
    IReadOnlyList<MockupManifestRecord> manifestRecords,
    string batchId)
    {
        // Phase 1: Validate method inputs and selected files.

        ArgumentNullException.ThrowIfNull(manifestRecords);

        if (manifestRecords.Count == 0)
        {
            throw new InvalidOperationException(
                "The Mosswick manifest contains no records.");
        }

        if (string.IsNullOrWhiteSpace(batchId))
        {
            throw new ArgumentException(
                "Batch ID is required.",
                nameof(batchId));
        }

        if (mosswickSourceImages.Count == 0)
        {
            throw new InvalidOperationException(
                "Select the Mosswick source image files before importing.");
        }

        var duplicateFileNames = mosswickSourceImages
            .GroupBy(
                file => Path.GetFileName(file.Name),
                StringComparer.OrdinalIgnoreCase)
            .Where(group => group.Count() > 1)
            .Select(group => group.Key)
            .OrderBy(
                fileName => fileName,
                StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (duplicateFileNames.Count > 0)
        {
            throw new InvalidOperationException(
                "Multiple selected files have the same filename: " +
                string.Join(", ", duplicateFileNames));
        }

        // Phase 2 will begin here.

        var selectedFilesByName = mosswickSourceImages
            .ToDictionary(
                file => Path.GetFileName(file.Name),
                file => file,
                StringComparer.OrdinalIgnoreCase);
        
        var mapper = new MockupManifestItemMapper();

        const long maxImageSize =
            100L * 1024L * 1024L;

        var preparedImages = new List<(
    string FolderName,
    string SourceFileName,
    IBrowserFile BrowserFile)>();

        foreach (var record in manifestRecords)
        {
            if (string.IsNullOrWhiteSpace(record.SourceImageFile))
            {
                throw new InvalidOperationException(
                    $"Manifest record '{record.ArtworkId}' " +
                    "does not specify SourceImageFile.");
            }

            var sourceFileName = Path.GetFileName(
                record.SourceImageFile.Replace('\\', '/'));

            if (string.IsNullOrWhiteSpace(sourceFileName))
            {
                throw new InvalidOperationException(
                    $"Manifest record '{record.ArtworkId}' " +
                    "contains an invalid SourceImageFile.");
            }

            if (!selectedFilesByName.TryGetValue(
                    sourceFileName,
                    out var browserFile))
            {
                throw new InvalidOperationException(
                    $"The source image '{sourceFileName}' referenced by " +
                    $"artwork '{record.ArtworkId}' was not selected.");
            }

            var item = mapper.Map(record, batchId);

            if (string.IsNullOrWhiteSpace(item.FolderName))
            {
                throw new InvalidOperationException(
                    $"No input folder could be determined for " +
                    $"artwork '{record.ArtworkId}'.");
            }

            var safeFolderName = Path.GetFileName(item.FolderName);

            if (!string.Equals(
                    safeFolderName,
                    item.FolderName,
                    StringComparison.Ordinal))
            {
                throw new InvalidOperationException(
                    $"The generated folder name '{item.FolderName}' is invalid.");
            }
            if (browserFile.Size > maxImageSize)
            {
                throw new InvalidOperationException(
                    $"The source image '{sourceFileName}' exceeds " +
                    "the maximum allowed size of 100 MB.");
            }

            preparedImages.Add((
                safeFolderName,
                sourceFileName,
                browserFile));
        }
        // Phase 3: Prepare the incoming batch directories.

        var incomingFolderName =
            $"mosswick-{batchId}";

        var incomingBatchRoot = Path.Combine(
            "/incoming",
            incomingFolderName);

        var inputFoldersRoot = Path.Combine(
            incomingBatchRoot,
            "input_folders");

        if (Directory.Exists(incomingBatchRoot))
        {
            Directory.Delete(
                incomingBatchRoot,
                recursive: true);
        }

        Directory.CreateDirectory(inputFoldersRoot);

        // Phase 4 will begin here.
        // Phase 4: Copy the validated source images.

        foreach (var preparedImage in preparedImages)
        {
            var destinationFolder = Path.Combine(
                inputFoldersRoot,
                preparedImage.FolderName);

            Directory.CreateDirectory(destinationFolder);

            var destinationPath = Path.Combine(
                destinationFolder,
                preparedImage.SourceFileName);

            await using var sourceStream =
                preparedImage.BrowserFile.OpenReadStream(
                    maxImageSize);

            await using var destinationStream =
                new FileStream(
                    destinationPath,
                    FileMode.Create,
                    FileAccess.Write,
                    FileShare.None,
                    bufferSize: 81920,
                    useAsync: true);

            await sourceStream.CopyToAsync(
                destinationStream);

            Console.WriteLine(
                $"Prepared Mosswick source image: " +
                $"'{destinationPath}'");
        }
        return incomingFolderName;
    }
}